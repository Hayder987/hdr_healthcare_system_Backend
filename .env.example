NODE_ENV=development
PORT=5000


DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ph_healthcare?schema=public"

JWT_ACCESS_SECRET=your secret
JWT_REFRESH_SECRET=your secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Used to build absolute links back to this API (not read anywhere yet).
BACKEND_URL=http://localhost:5000

# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID= your client id

SUPER_ADMIN_NAME=name
SUPER_ADMIN_EMAIL=email
SUPER_ADMIN_PASSWORD= password


TESTER_ADMIN_NAME=name
TESTER_ADMIN_EMAIL=email
TESTER_ADMIN_PASSWORD=password


TESTER_DOCTOR_NAME=name
TESTER_DOCTOR_EMAIL=email
TESTER_DOCTOR_PASSWORD=password

REDIS_USER=default
REDIS_PASSWORD=your password
REDIS_HOST=your host
REDIS_PORT=your password