<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>Password Reset - HDR Healthcare System</title>

  <style>
    body { margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #1f2937; }
    .wrapper { width: 100%; padding: 40px 16px; background-color: #f4f7fb; box-sizing: border-box; }
    .container { width: 100%; max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08); }
    .header { padding: 28px 32px; background-color: #0f766e; text-align: center; }
    .brand { margin: 0; color: #ffffff; font-size: 24px; font-weight: 700; letter-spacing: 0.3px; }
    .brand-subtitle { margin: 6px 0 0; color: #ccfbf1; font-size: 13px; }
    .content { padding: 40px 40px 32px; }
    .icon { width: 52px; height: 52px; margin: 0 auto 22px; border-radius: 50%; background-color: #ecfdf5; color: #0f766e; font-size: 24px; line-height: 52px; text-align: center; }
    .title { margin: 0 0 12px; color: #111827; font-size: 25px; line-height: 1.3; font-weight: 700; text-align: center; }
    .description { margin: 0 0 24px; color: #6b7280; font-size: 15px; line-height: 1.7; text-align: center; }
    .otp-label { margin: 0 0 10px; color: #6b7280; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-align: center; text-transform: uppercase; }
    .otp-box { margin: 0 auto 24px; padding: 18px 20px; background-color: #f0fdfa; border: 1px solid #99f6e4; border-radius: 12px; text-align: center; }
    .otp { margin: 0; color: #0f766e; font-size: 34px; line-height: 1.2; font-weight: 700; letter-spacing: 8px; }
    .expiry { margin: 0; padding: 14px 16px; background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; color: #92400e; font-size: 13px; line-height: 1.6; text-align: center; }
    .security { margin: 24px 0 0; color: #6b7280; font-size: 13px; line-height: 1.7; text-align: center; }
    .footer { padding: 24px 32px; background-color: #f8fafc; border-top: 1px solid #e5e7eb; text-align: center; }
    .footer-text { margin: 0 0 6px; color: #6b7280; font-size: 12px; line-height: 1.6; }
    .copyright { margin: 0; color: #9ca3af; font-size: 11px; }
    @media only screen and (max-width: 600px) { .wrapper { padding: 20px 12px; } .content { padding: 32px 24px 28px; } .header { padding: 24px 20px; } .title { font-size: 22px; } .otp { font-size: 30px; letter-spacing: 6px; } .footer { padding: 20px; } }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="container">

      <div class="header">
        <h1 class="brand">HDR Healthcare System</h1>
        <p class="brand-subtitle">Secure Healthcare Management</p>
      </div>

      <div class="content">

        <div class="icon">🔐</div>

        <h2 class="title">Password Reset Request</h2>

        <p class="description">
          Hello <strong><%= name %></strong>, we received a request to reset
          your password. Use the verification code below to continue.
        </p>

        <p class="otp-label">Your Verification Code</p>

        <div class="otp-box">
          <p class="otp"><%= otp %></p>
        </div>

        <p class="expiry">
          ⏱ This verification code will expire in
          <strong><%= expirationMinutes %> minutes</strong>.
        </p>

        <p class="security">
          If you did not request a password reset, you can safely ignore this
          email. Your account remains secure.
        </p>

      </div>

      <div class="footer">
        <p class="footer-text">
          This is an automated message. Please do not reply to this email.
        </p>

        <p class="copyright">
          &copy; <%= new Date().getFullYear() %> HDR Healthcare System.
          All rights reserved.
        </p>
      </div>

    </div>
  </div>
</body>
</html>